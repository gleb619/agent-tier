{
  "name": "@gleb619/agent-tier",
  "version": "0.1.0",
  "description": "Thin wrapper for routing coding tasks to tiered AI agents",
  "bin": {
    "at": "./dist/cli.js"
  },
  "scripts": {
    "build": "[ -f env.local.sh ] && . ./env.local.sh; tsc",
    "dev": "[ -f env.local.sh ] && . ./env.local.sh; ts-node src/cli.ts",
    "test": "[ -f env.local.sh ] && . ./env.local.sh; vitest run",
    "test:watch": "[ -f env.local.sh ] && . ./env.local.sh; vitest",
    "test:agents": "[ -f env.local.sh ] && . ./env.local.sh; vitest run tests_ai/",
    "test:coverage": "vitest run --coverage",
    "test:gaps": "npx ts-node scripts/coverage-gaps.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentui/core": "^0.2.15",
    "@opentui/solid": "^0.2.15",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "solid-js": "^1.9.12",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
