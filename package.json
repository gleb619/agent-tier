{
  "name": "@gleb619/agent-tier",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Thin wrapper for routing coding tasks to tiered AI agents",
  "bin": {
    "at": "./dist/cli.js"
  },
  "scripts": {
    "build": "[ -f env.local.sh ] && . ./env.local.sh; tsc && npm run web:build && npm run build:go",
    "dev": "[ -f env.local.sh ] && . ./env.local.sh; ts-node src/cli.ts",
    "test": "[ -f env.local.sh ] && . ./env.local.sh; vitest run",
    "test:watch": "[ -f env.local.sh ] && . ./env.local.sh; vitest",
    "test:e2e": "[ -f env.local.sh ] && . ./env.local.sh; PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-$PWD/.pw-browsers} vitest run --config vitest.e2e.config.ts",
    "test:agents": "[ -f env.local.sh ] && . ./env.local.sh; AT_LIVE_AGENTS=1 vitest run --config vitest.live.config.ts",
    "test:all": "pnpm run test && pnpm run test:agents",
    "test:coverage": "vitest run --coverage",
    "test:gaps": "npx ts-node --project scripts/tsconfig.json scripts/coverage-gaps.ts",
    "test:guard": "bash scripts/test-guard.sh check",
    "test:orphans": "bash scripts/test-guard.sh orphans",
    "hooks:install": "git config core.hooksPath .githooks",
    "build:go": "export PATH=$PATH:/usr/local/go/bin; if ! command -v go >/dev/null 2>&1; then echo '[build:go] go not found, skipping at-web build'; exit 0; fi; cd web-server && go build -trimpath -ldflags \"-s -w\" -o ../bin/at-web ./cmd/at-web",
    "build:bin": "bash scripts/build-at-bin.sh",
    "build:mock": "make build",
    "test:go": "make test-go",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci:check": "bash scripts/ci-check.sh",
    "web:dev": "pnpm -C src/webui dev",
    "web:analyze": "npm --prefix src/webui run build && npm --prefix src/webui run analyze",
    "web:build": "npm --prefix src/webui run build",
    "web:check": "pnpm -C src/webui check",
    "web:lighthouse": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-$PWD/.pw-browsers} vite-node scripts/web-lighthouse.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.78.1",
    "@earendil-works/pi-ai": "^0.78.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentui/core": "^0.5.7",
    "@opentui/solid": "^0.5.7",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "solid-js": "^1.9.12",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mdast": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "chrome-launcher": "1.2.2",
    "lighthouse": "^13.5.0",
    "playwright": "1.60.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "vite-node": "3.2.4",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "pnpm": {
    "publicHoistPattern": [
      "*types*",
      "*eslint*",
      "*prettier*"
    ],
    "overrides": {
      "vite": "5.4.21"
    }
  }
}
